# Cloudflare 정적 호스팅 응답 헤더(빌드 때 out으로 복사된다)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=86400

/videos/*
  Cache-Control: public, max-age=86400

/models/*
  Cache-Control: public, max-age=86400

# 11-27 사용자 "최초로 했던 걸로 하고 불러오기": 트렌드형 원본(/trend, 파일은 trend.html)만 아임웹 주소 전체에서 액자(iframe)로 불러올 수 있게(11-27 대표 "허용 넓혀": 포트폴리오 화면 ebo.imweb.me, imweb.me가 곰파트너 판을 다시 액자로 띄워 바깥 주소까지 허용해야 한다).
# 다른 주소는 위 /* 그대로(우리 사이트 밖에서 끼우기 금지)
/trend
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://imweb.me https://*.imweb.me; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
/trend.html
  ! X-Frame-Options
  ! Content-Security-Policy
  Content-Security-Policy: frame-ancestors 'self' https://imweb.me https://*.imweb.me; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
